<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.aes128.vpn</string>
	</array>
	<key>BundleProgram</key>
	<string>Contents/MacOS/aes128-helper</string>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.aes128.vpn.helper</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/aes128-helper.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/aes128-helper.log</string>
</dict>
</plist>
