#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
app='/Applications/AES128 VPN.app'
label='com.aes128.vpn.helper'
fail() { echo "AES128 VPN: $*" >&2; exit 1; }
[ "${3:-/}" = / ] || fail 'Install on the current startup disk.'
[ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = 1 ] || fail 'This installer requires a Mac with an Apple M-series chip.'
major=$(sw_vers -productVersion | cut -d . -f 1)
[ "$major" -ge 13 ] || fail 'macOS 13 or later is required.'
if pgrep -x aes128 >/dev/null; then
    fail 'Quit AES128 VPN (Command-Q), then run the installer again.'
fi
if [ -f /Library/LaunchDaemons/com.aes128.vpn.helper.plist ]; then
    if launchctl print "system/$label" >/dev/null 2>&1; then
        launchctl bootout "system/$label" || fail 'Could not stop the installed VPN service.'
    fi
elif [ -x "$app/Contents/MacOS/aes128" ]; then
    console_uid=$(stat -f %u /dev/console)
    if [ "$console_uid" -ge 501 ]; then
        if ! launchctl asuser "$console_uid" sudo -n -u "#$console_uid" "$app/Contents/MacOS/aes128" --unregister-helper; then
            if launchctl print "system/$label" >/dev/null 2>&1; then
                fail 'Could not stop the installed VPN service. Open AES128 VPN, disconnect, and try again.'
            fi
        fi
    elif launchctl print "system/$label" >/dev/null 2>&1; then
        fail 'Sign in to the Mac before updating AES128 VPN.'
    fi
fi
count=0
while pgrep -x aes128-helper >/dev/null; do
    [ "$count" -lt 65 ] || fail 'The VPN service is still shutting down. Try installing again shortly.'
    sleep 1
    count=$((count + 1))
done
exit 0
